# ReconMint environment - copy this file to .env in the same folder and fill it in.
# .env is gitignored, so your keys never leave your machine.
#
# All three of the LLM + Razorpay features degrade gracefully if the keys are
# missing. You can run the whole reconciliation loop with an empty .env - only
# the "Explain with AI", "Ask the agent", and "Truth-Anchor" features need the
# keys below to be real.

# ------------------------------------------------------------------------------
# OpenAI - used only to phrase natural-language answers and explanations.
# ------------------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys. Any key with credit works.
# Cost is negligible in normal use (~$0.0001 per verified explanation).
OPENAI_API_KEY=sk-your-openai-key-here

# Model + provider config. Defaults are fine for review.
RECONMINT_LLM_PROVIDER=openai
RECONMINT_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Razorpay - TEST-MODE keys. Powers the live API handshake at ingest and the
# Truth-Anchor Agent that appeals every exception to api.razorpay.com.
# ------------------------------------------------------------------------------
# Get test keys at https://dashboard.razorpay.com/app/website-app-settings/api-keys
# (switch to Test Mode in the top-right first). Test keys start with rzp_test_.
# ReconMint never hits live-mode Razorpay - only test-mode endpoints.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ------------------------------------------------------------------------------
# Optional: everything below is fine to leave commented out for local review.
# ------------------------------------------------------------------------------
# Custom SQLite audit DB path (defaults to ./data/audit.db)
# RECONMINT_DB=./data/audit.db

# CORS origins for the frontend. Leave unset for local dev - the Vite proxy
# handles it. Only set this on a deployed backend that lives on a different
# origin from the frontend.
# RECONMINT_CORS_ORIGINS=https://reconmint.pages.dev
