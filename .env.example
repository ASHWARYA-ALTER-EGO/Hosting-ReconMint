# Copy to .env and fill in. .env is gitignored and never committed.
OPENAI_API_KEY=sk-...

# LLM config - switch models/providers here without touching code.
# Cheapest default is gpt-4o-mini. Other options: gpt-4.1-nano, gpt-4.1-mini.
RECONMINT_LLM_PROVIDER=openai
RECONMINT_LLM_MODEL=gpt-4o-mini

# Optional: SQLite audit DB path (Railway volume in prod)
# RECONMINT_DB=/data/audit.db

# Comma-separated frontend origins allowed by CORS (required when frontend calls backend directly).
# Example: RECONMINT_CORS_ORIGINS=https://reconmint.up.railway.app
# Default * allows all origins (fine when nginx proxies same-origin on the frontend service).
